# Copy this file to .env and replace the account placeholder before starting Vita.

# Local database setting.
POSTGRES_PASSWORD=lunavita-dev

# Luna Visia service reachable through the shared luna_sentia_network.
LUNAVISIA_API_URL=http://luna-visia-mcp:8000

# Immutable Luna Visia image ID used when a food entry has no matched image.
LUNAVITA_PLACEHOLDER_IMAGE_ID=b7adf6ae-30b3-4750-8381-5dc6ab393de6

# Comma-separated, verified Google accounts allowed to use the Streamlit UI.
LUNAVITA_ALLOWED_EMAILS=you@example.com

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18001

# Defaults from docker-compose.yaml, listed so every container setting is explicit.
POSTGRES_USER=lunavita
POSTGRES_DB=lunavita
